      "timeout_seconds": 30,
      "returns": "json",
      "requires_confirmation": false,
      "use_cases": [
        "Regular disk usage monitoring",
        "Alert when capacity thresholds exceeded",
        "Trend analysis of storage growth",
        "Cleanup recommendations"
      ]
    },
    {
      "name": "docker-health",
      "description": "Check Docker container health status",
      "category": "monitoring",
      "command": "ssh -i ~/.secret/claude_key root@10.1.10.10 'docker ps --format json'",
      "timeout_seconds": 15,
      "returns": "json",
      "requires_confirmation": false,
      "status": "planned"
    },
    {
      "name": "restart-container",
      "description": "Gracefully restart a Docker container",
