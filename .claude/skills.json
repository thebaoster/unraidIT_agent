      "description": "Check Docker container health status",
      "category": "monitoring",
      "command": "ssh -i ~/.secret/claude_key root@10.1.10.10 'docker ps --format json'",
      "timeout_seconds": 15,
      "returns": "json",
      "requires_confirmation": false,
      "status": "planned"
    },
    {
      "name": "cleanup-suggestions",
