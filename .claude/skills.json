      "command": "ssh -i ~/.secret/claude_key root@10.1.10.10 'bash /opt/claude-agent/scripts/cleanup_suggestions.sh'",
      "timeout_seconds": 30,
      "returns": "json",
      "requires_confirmation": false,
      "use_cases": [
        "Identify safe cleanup options",
        "Estimate space that can be freed",
