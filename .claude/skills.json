      "timeout_seconds": 30,
      "returns": "json",
      "requires_confirmation": false,
      "use_cases": [
        "Regular disk usage monitoring",
        "Alert when capacity thresholds exceeded",
        "Trend analysis of storage growth",
        "Cleanup recommendations"
      ]
    },
    {
